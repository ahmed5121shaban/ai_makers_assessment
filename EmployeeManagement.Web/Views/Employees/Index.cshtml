@model EmployeeListViewModel
@{
    ViewData["Title"] = "Employees";
}

<div class="page-header">
    <h1><i class="bi bi-person-badge me-2"></i>Employees</h1>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i>Add Employee
    </a>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-8">
                <div class="input-group search-box">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" class="form-control" placeholder="Search by name or department..." value="@Model.Search" />
                </div>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-outline-primary w-100">
                    <i class="bi bi-search me-1"></i>Search
                </button>
            </div>
            <div class="col-md-2">
                <a asp-action="Index" class="btn btn-outline-secondary w-100">
                    <i class="bi bi-x-lg me-1"></i>Clear
                </a>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0 table-responsive-mobile">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Full Name</th>
                        <th>Email</th>
                        <th>Mobile</th>
                        <th>Department</th>
                        <th>Job Title</th>
                        <th>Hire Date</th>
                        <th>Status</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Employees.Any())
                    {
                        <tr>
                            <td colspan="9">
                                <div class="empty-state">
                                    <div class="empty-state-icon">
                                        <i class="bi bi-inbox"></i>
                                    </div>
                                    <div class="empty-state-title">No employees found</div>
                                    <div class="empty-state-text">
                                        @if (!string.IsNullOrEmpty(Model.Search))
                                        {
                                            <span>Try a different search term.</span>
                                        }
                                        else
                                        {
                                            <span>Get started by adding your first employee.</span>
                                        }
                                    </div>
                                    @if (string.IsNullOrEmpty(Model.Search))
                                    {
                                        <a asp-action="Create" class="btn btn-primary">
                                            <i class="bi bi-plus-lg me-1"></i>Add Employee
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    @foreach (var employee in Model.Employees)
                    {
                        <tr>
                            <td class="fw-medium">@employee.EmployeeId</td>
                            <td>@employee.FullName</td>
                            <td>@employee.Email</td>
                            <td>@employee.MobileNumber</td>
                            <td><span class="badge badge-department">@employee.DepartmentName</span></td>
                            <td>@employee.JobTitle</td>
                            <td>@employee.HireDate.ToString("yyyy-MM-dd")</td>
                            <td>
                                @if (employee.IsActive)
                                {
                                    <span class="badge badge-active">Active</span>
                                }
                                else
                                {
                                    <span class="badge badge-inactive">Inactive</span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="action-btn-group justify-content-center">
                                    <a asp-action="Details" asp-route-id="@employee.EmployeeId" class="btn btn-outline-info" title="View Details" data-bs-toggle="tooltip">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@employee.EmployeeId" class="btn btn-outline-primary" title="Edit" data-bs-toggle="tooltip">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <button type="button" class="btn btn-outline-danger" title="Deactivate" data-bs-toggle="tooltip"
                                            data-bs-toggle="modal" data-bs-target="#deleteModal"
                                            data-id="@employee.EmployeeId" data-name="@employee.FullName">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-4">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                <a class="page-link" asp-route-page="@(Model.Page - 1)" asp-route-search="@Model.Search" aria-label="Previous">
                    <i class="bi bi-chevron-left"></i>
                </a>
            </li>
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")">
                    <a class="page-link" asp-route-page="@i" asp-route-search="@Model.Search">@i</a>
                </li>
            }
            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-route-page="@(Model.Page + 1)" asp-route-search="@Model.Search" aria-label="Next">
                    <i class="bi bi-chevron-right"></i>
                </a>
            </li>
        </ul>
    </nav>
}

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">
                    <i class="bi bi-exclamation-triangle text-danger me-2"></i>Confirm Deactivation
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="mb-1">Are you sure you want to deactivate <strong id="deleteEmployeeName"></strong>?</p>
                <small class="text-muted">The employee record will be preserved but marked as inactive.</small>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <form id="deleteForm" method="post" asp-action="Delete" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="deleteEmployeeId" />
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash me-1"></i>Deactivate
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const deleteModal = document.getElementById('deleteModal');
        deleteModal.addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            document.getElementById('deleteEmployeeId').value = button.getAttribute('data-id');
            document.getElementById('deleteEmployeeName').textContent = button.getAttribute('data-name');
        });
    </script>
}
