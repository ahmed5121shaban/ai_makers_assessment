@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="page-header">
    <h1><i class="bi bi-speedometer2 me-2"></i>Dashboard</h1>
</div>

<div class="row g-4">
    <div class="col-md-3 col-6 stagger-1">
        <div class="stat-card card animate-fade-in-up">
            <div class="card-body p-4">
                <div class="stat-icon stat-icon-primary">
                    <i class="bi bi-people"></i>
                </div>
                <div class="stat-value text-primary">@Model.TotalEmployees</div>
                <div class="stat-label">Total Employees</div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-6 stagger-2">
        <div class="stat-card card animate-fade-in-up">
            <div class="card-body p-4">
                <div class="stat-icon stat-icon-success">
                    <i class="bi bi-person-check"></i>
                </div>
                <div class="stat-value text-success">@Model.ActiveEmployees</div>
                <div class="stat-label">Active</div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-6 stagger-3">
        <div class="stat-card card animate-fade-in-up">
            <div class="card-body p-4">
                <div class="stat-icon stat-icon-danger">
                    <i class="bi bi-person-x"></i>
                </div>
                <div class="stat-value text-danger">@Model.InactiveEmployees</div>
                <div class="stat-label">Inactive</div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-6 stagger-4">
        <div class="stat-card card animate-fade-in-up">
            <div class="card-body p-4">
                <div class="stat-icon stat-icon-warning">
                    <i class="bi bi-building"></i>
                </div>
                <div class="stat-value text-warning">@Model.TotalDepartments</div>
                <div class="stat-label">Departments</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mt-2">
    <div class="col-md-6">
        <div class="action-card card text-center p-4 animate-fade-in-up stagger-1">
            <div class="card-body">
                <div class="action-icon bg-soft-primary mx-auto">
                    <i class="bi bi-person-badge text-primary"></i>
                </div>
                <h5 class="fw-semibold mt-3">Manage Employees</h5>
                <p class="text-muted small">Add, edit, and manage employee records</p>
                <a asp-controller="Employees" asp-action="Index" class="btn btn-primary px-4">
                    <i class="bi bi-arrow-right me-1"></i>Go to Employees
                </a>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="action-card card text-center p-4 animate-fade-in-up stagger-2">
            <div class="card-body">
                <div class="action-icon bg-soft-warning mx-auto">
                    <i class="bi bi-building text-warning"></i>
                </div>
                <h5 class="fw-semibold mt-3">Manage Departments</h5>
                <p class="text-muted small">Organize departments and structure</p>
                <a asp-controller="Departments" asp-action="Index" class="btn btn-outline-primary px-4">
                    <i class="bi bi-arrow-right me-1"></i>Go to Departments
                </a>
            </div>
        </div>
    </div>
</div>
