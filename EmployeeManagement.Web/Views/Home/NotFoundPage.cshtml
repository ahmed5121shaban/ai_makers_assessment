@{
    ViewData["Title"] = "Page Not Found";
}

<div class="error-page error-bg-pattern">
    <div class="text-center">
        <div class="error-code text-warning">404</div>
        <h2 class="text-muted mb-3">Page Not Found</h2>
        <p class="text-muted mb-4">The resource you're looking for doesn't exist or has been removed.</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4">
            <i class="bi bi-house-door me-1"></i>Back to Dashboard
        </a>
    </div>
</div>
