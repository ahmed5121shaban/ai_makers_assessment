@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
}

<nav class="navbar navbar-expand-lg navbar-dark sticky-top" style="background-color: #4F46E5;">
    <div class="container">
        <a class="navbar-brand fw-bold d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
            <i class="bi bi-people-fill fs-5"></i>
            <span>Employee Management</span>
        </a>
        <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item">
                    <a class="nav-link @(controller == "Home" && action == "Index" ? "active" : "")"
                       asp-controller="Home" asp-action="Index">
                        <i class="bi bi-speedometer2 me-1"></i>Dashboard
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(controller == "Employees" ? "active" : "")"
                       asp-controller="Employees" asp-action="Index">
                        <i class="bi bi-person-badge me-1"></i>Employees
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(controller == "Departments" ? "active" : "")"
                       asp-controller="Departments" asp-action="Index">
                        <i class="bi bi-building me-1"></i>Departments
                    </a>
                </li>
            </ul>
        </div>
    </div>
</nav>
