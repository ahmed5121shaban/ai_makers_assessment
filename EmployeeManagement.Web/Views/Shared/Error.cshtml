@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="error-page error-bg-pattern">
    <div class="text-center">
        <div class="error-code text-danger">500</div>
        <h2 class="text-muted mb-3">Something went wrong</h2>
        <p class="text-muted mb-4">An unexpected error occurred. Please try again later.</p>

        @if (Model.ShowRequestId)
        {
            <div class="mb-4">
                <small class="text-muted d-block mb-1">Request ID</small>
                <code class="px-3 py-2 bg-light rounded">@Model.RequestId</code>
            </div>
        }

        <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4">
            <i class="bi bi-house-door me-1"></i>Back to Dashboard
        </a>
    </div>
</div>
